rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny — toute collection non listée explicitement ci-dessous
    // reste totalement inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Players collection
    // Lu par tous les visiteurs authentifiés (y compris avant la sélection
    // du profil / saisie du code PIN, qui est gérée côté application, pas
    // par Firebase Auth). L'app ne supprime jamais un joueur (elle le
    // marque "archived: true"), donc aucune permission de suppression n'est
    // accordée ici.
    match /players/{playerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // 2. Matches collection
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 3. Withdrawals collection (détection des désinscriptions tardives —
    // src/lib/withdrawalWatcher.js, CourtPanel.jsx, Header.jsx). Absente des
    // règles précédentes : toutes ces lectures/écritures étaient refusées
    // en silence, rendant la fonctionnalité inopérante en production.
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // 4. Player credentials collection (codes PIN) — verrouillée : ni lisible
    // ni modifiable depuis un navigateur, quel que soit l'utilisateur. Seul
    // le SDK Admin Firebase (utilisé par les fonctions serveur api/verify-pin
    // et api/manage-pin, jamais exécuté dans un navigateur) peut y accéder,
    // car il contourne complètement ces règles.
    match /player_credentials/{playerId} {
      allow read, write: if false;
    }

    // 5. Settings collection — réglages globaux de l'app (ex. activation du
    // Fun Center pour tous les joueurs, voir src/views/AdminView.jsx). Même
    // niveau d'accès que le reste des collections ci-dessus.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // 6. Games collection — état partagé des mini-jeux du Fun Center (ex.
    // "games/tourneeGenerale" : historique du jour des joueurs déjà tirés
    // au sort pour la tournée générale, voir src/lib/tourneeGenerale.js).
    // Même niveau d'accès que le reste des collections ci-dessus.
    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // Remarque : "isSignedIn()" est vrai dès qu'un visiteur charge le site,
    // même sans code PIN valide, car l'app se connecte automatiquement à
    // Firebase de façon anonyme (voir src/firebase.js). Cela bloque l'accès
    // direct à la base par un script/robot qui ne charge jamais le site,
    // mais ne distingue pas un joueur d'un administrateur au niveau de la
    // base de données : cette distinction reste gérée côté application
    // uniquement. Une isolation plus stricte (empêcher un joueur non-admin
    // d'écrire dans les documents d'un autre joueur, par exemple) nécessite
    // une vraie authentification Firebase par compte (email ou téléphone)
    // avec des rôles ("custom claims"), ce qui est une évolution plus lourde
    // à prévoir séparément si le besoin s'en fait sentir.
  }
}
