rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Rôles protégés (25/10/2026) : jamais modifiables depuis un navigateur,
    // seulement par le serveur (api/manage-roles.js).
    function roleFields() {
      return ['isAdmin', 'isCoach', 'isCreditor', 'isOwner', 'isTest', 'isGuest'];
    }
    function createsWithoutRoles() {
      let d = request.resource.data;
      return d.get('isAdmin', false) != true
        && d.get('isCoach', false) != true
        && d.get('isCreditor', false) != true
        && d.get('isOwner', false) != true
        && d.get('isTest', false) != true
        && d.get('isGuest', false) != true;
    }
    function keepsRoles() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(roleFields());
    }

    // Refus par défaut pour toute collection non listée
    match /{document=**} {
      allow read, write: if false;
    }

    match /players/{playerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && createsWithoutRoles();
      allow update: if isSignedIn() && keepsRoles();
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /abonnements/{abonnementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // Codes PIN : serveur uniquement
    match /player_credentials/{playerId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /killerMissions/{missionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /mvpVotes/{matchId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // Confidences « Liens entre joueurs » : serveur uniquement
    match /adminRelations/{docId} {
      allow read, write: if false;
    }
  }
}
